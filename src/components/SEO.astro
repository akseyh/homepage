---
import { site, socials } from "../data/site";

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
}

const {
  title,
  description,
  image = `${site.url}/og.png`,
  canonical = new URL(
    Astro.url.pathname.replace(/\/+$/, "") || "/",
    site.url,
  ).href,
  type = "website",
} = Astro.props;

const pageTitle = title === "Home" ? `${site.name} — ${site.role}` : `${title} — ${site.name}`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.shortName,
  url: site.url,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  sameAs: socials.map((social) => social.href),
};
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.role}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitter} />
<meta name="twitter:creator" content={site.twitter} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<script type="application/ld+json" set:html={JSON.stringify(person)} />
