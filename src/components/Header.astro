---
import { site } from "../data/site";

const links = [
  { href: "/", label: "/home" },
  { href: "/about", label: "/about" },
  { href: "/blog", label: "/blog" },
  { href: "/contact", label: "/contact" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => currentPath === href;
---

<header class="border-b border-slate-800">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4" aria-label="Main">
    <a
      href="/"
      class="font-mono text-lg font-bold text-accent transition-opacity hover:opacity-80"
    >
      {site.title}
    </a>

    <ul class="hidden gap-6 sm:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "font-mono text-sm transition-colors hover:text-accent",
                isActive(link.href) ? "text-accent" : "text-slate-400",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="menu-btn"
      type="button"
      class="text-slate-400 transition-colors hover:text-accent sm:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        id="menu-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg
        id="menu-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-slate-800 sm:hidden">
    <ul class="flex flex-col gap-2 px-4 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "block font-mono text-sm transition-colors hover:text-accent",
                isActive(link.href) ? "text-accent" : "text-slate-400",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });
</script>
