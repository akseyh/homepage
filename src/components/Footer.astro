---
import { site, socials } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-2 px-4 py-6 sm:flex-row sm:justify-between"
  >
    <p class="font-mono text-xs text-slate-500">&copy; {year} {site.title}</p>
    <div class="flex gap-4">
      {
        socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs text-slate-500 transition-colors hover:text-accent"
          >
            {social.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
