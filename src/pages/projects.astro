---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout
  title="Projects"
  description="Projects by Şems Yılmaz — backend systems, product work, and tools built end to end."
>
  <section class="flex flex-col gap-8">
    <div>
      <p class="font-mono text-sm text-accent">/projects</p>
      <h1 class="mt-2 font-mono text-3xl font-bold text-white sm:text-4xl">
        projects
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-400">
        Things I&rsquo;ve designed, built, and shipped &mdash; mostly products
        where I owned the whole path from schema to deployment.
      </p>
    </div>

    <div class="flex flex-col gap-4">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
