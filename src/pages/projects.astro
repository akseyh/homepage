---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout
  title="Projects"
  description="Projects built by sems."
>
  <section class="flex flex-col gap-8">
    <div>
      <p class="font-mono text-sm text-accent">/projects</p>
      <h1 class="mt-2 font-mono text-3xl font-bold text-white sm:text-4xl">
        things i&rsquo;ve built
      </h1>
      <p class="mt-3 text-sm text-slate-400">
        A selection of open-source projects, tools, and experiments.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
