---
import BaseLayout from "../layouts/BaseLayout.astro";
import { email, socials } from "../data/site";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Şems Yılmaz — email, GitHub, X, LinkedIn, and YouTube."
>
  <section class="flex flex-col gap-8">
    <div>
      <p class="font-mono text-sm text-accent">/contact</p>
      <h1 class="mt-2 font-mono text-3xl font-bold text-white sm:text-4xl">
        get in touch
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-400">
        I&rsquo;m open to backend and platform roles, contract work, and
        conversations about money systems, Kafka, or AI tooling. Email is the
        fastest way to reach me.
      </p>
    </div>

    <div class="flex flex-col gap-3">
      {
        [email, ...socials].map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="group flex items-center justify-between gap-3 rounded-lg border border-slate-800 p-4 transition-colors hover:border-accent"
          >
            <span class="font-mono text-sm text-accent">{link.label}</span>
            <span class="font-mono text-sm text-slate-400 transition-colors group-hover:text-white">
              {link.handle}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
