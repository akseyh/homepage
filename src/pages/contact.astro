---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with sems."
>
  <section class="flex flex-col gap-8">
    <div>
      <p class="font-mono text-sm text-accent">/contact</p>
      <h1 class="mt-2 font-mono text-3xl font-bold text-white sm:text-4xl">
        get in touch
      </h1>
      <p class="mt-3 text-sm text-slate-400">
        I&rsquo;m always open to interesting conversations, collaboration
        opportunities, or just a friendly hello.
      </p>
    </div>

    <div class="flex flex-col gap-4">
      <a
        href="mailto:yilmazsems@gmail.com"
        class="group flex items-center gap-3 rounded-lg border border-slate-800 p-4 transition-colors hover:border-accent"
      >
        <span class="font-mono text-sm text-accent">email</span>
        <span class="font-mono text-sm text-slate-400 transition-colors group-hover:text-white">
          yilmazsems@gmail.com
        </span>
      </a>
      <a
        href="https://github.com/akseyh"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 rounded-lg border border-slate-800 p-4 transition-colors hover:border-accent"
      >
        <span class="font-mono text-sm text-accent">github</span>
        <span class="font-mono text-sm text-slate-400 transition-colors group-hover:text-white">
          github.com/akseyh
        </span>
      </a>
      <a
        href="https://x.com/akseyh"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 rounded-lg border border-slate-800 p-4 transition-colors hover:border-accent"
      >
        <span class="font-mono text-sm text-accent">twitter</span>
        <span class="font-mono text-sm text-slate-400 transition-colors group-hover:text-white">
          x.com/akseyh
        </span>
      </a>
      <a
        href="https://www.linkedin.com/in/akseyh"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 rounded-lg border border-slate-800 p-4 transition-colors hover:border-accent"
      >
        <span class="font-mono text-sm text-accent">linkedin</span>
        <span class="font-mono text-sm text-slate-400 transition-colors group-hover:text-white">
          linkedin.com/in/akseyh
        </span>
      </a>
      <a
        href="https://www.youtube.com/@semsyilmaz"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 rounded-lg border border-slate-800 p-4 transition-colors hover:border-accent"
      >
        <span class="font-mono text-sm text-accent">youtube</span>
        <span class="font-mono text-sm text-slate-400 transition-colors group-hover:text-white">
          youtube.com/@semsyilmaz
        </span>
      </a>
    </div>
  </section>
</BaseLayout>
