---
import BaseLayout from "../layouts/BaseLayout.astro";

const experience = [
  {
    company: "Fiyuu (Tıkla Gelsin)",
    role: "Full-stack engineer",
    period: "2026 — now",
  },
  {
    company: "Cool Digital Solutions",
    role: "Software engineer",
    period: "2021 — 2026",
  },
  {
    company: "Fintech Software",
    role: "Frontend developer",
    period: "2020 — 2021",
  },
];

const education = [
  {
    degree: "MSc, Computer Engineering",
    school: "Sakarya University",
    period: "2026 — present",
  },
  {
    degree: "BSc, Computer Engineering",
    school: "Bilecik Şeyh Edebali University",
    period: "2017 — 2025",
  },
];

const stack = [
  { label: "backend", items: ["Node.js", "NestJS", "TypeScript", "gRPC", "REST / OpenAPI"] },
  { label: "data", items: ["PostgreSQL", "Kafka", "Redis", "MongoDB", "MSSQL", "DynamoDB"] },
  { label: "infra", items: ["AWS", "Kubernetes", "Docker", "Prometheus", "Grafana"] },
  { label: "frontend", items: ["React", "Next.js", "Vue", "Nuxt", "Astro"] },
];

const principles = [
  "Correctness before cleverness. I’d rather ship a boring system that holds than a clever one that needs a rescue.",
  "Own it end to end — design, implementation, deployment, and the dashboard after.",
  "Leave things easier to operate than I found them, and write down what I learned.",
];
---

<BaseLayout
  title="About"
  description="Şems Yılmaz — full-stack engineer with six years of experience across backend, data, and cloud infrastructure."
>
  <section class="flex flex-col gap-12">
    <div>
      <p class="font-mono text-sm text-accent">whoami</p>
      <h1 class="mt-2 font-mono text-3xl font-bold text-white sm:text-4xl">
        about me
      </h1>
    </div>

    <div class="space-y-4 text-sm leading-relaxed text-slate-400">
      <p>
        I&rsquo;m a full-stack engineer with six years of experience, mostly on
        the backend. I started on the frontend, which is probably why I still
        care about the experience of the people using the software as much as
        the API behind it.
      </p>
      <p>
        These days I work with Node.js, NestJS, TypeScript, Kafka, PostgreSQL,
        and Kubernetes. I like problems where correctness matters, interfaces
        are clear, and systems stay understandable after the first version.
      </p>
      <p>
        Outside of work I study networking, distributed systems, and cloud
        fundamentals, and I write about what I learn.
      </p>
    </div>

    <div>
      <h2
        class="mb-4 font-mono text-sm font-semibold uppercase tracking-wider text-slate-500"
      >
        experience
      </h2>
      <ol class="divide-y divide-slate-800 border-y border-slate-800">
        {
          experience.map((job) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-4">
              <div>
                <h3 class="font-mono text-base font-semibold text-white">
                  {job.company}
                </h3>
                <p class="font-mono text-xs text-accent">{job.role}</p>
              </div>
              <span class="font-mono text-xs text-slate-500">{job.period}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div>
      <h2
        class="mb-4 font-mono text-sm font-semibold uppercase tracking-wider text-slate-500"
      >
        how i work
      </h2>
      <ul class="space-y-3">
        {
          principles.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
              <span class="text-sm leading-relaxed text-slate-400">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2
        class="mb-4 font-mono text-sm font-semibold uppercase tracking-wider text-slate-500"
      >
        stack
      </h2>
      <dl class="space-y-3">
        {
          stack.map((group) => (
            <div class="grid gap-2 sm:grid-cols-[6rem_1fr] sm:gap-4">
              <dt class="font-mono text-xs text-slate-500">{group.label}</dt>
              <dd class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="rounded bg-slate-800 px-2.5 py-1 font-mono text-xs text-slate-300">
                    {item}
                  </span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      <h2
        class="mb-4 font-mono text-sm font-semibold uppercase tracking-wider text-slate-500"
      >
        education
      </h2>
      <ul class="space-y-3">
        {
          education.map((item) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4">
              <span class="text-sm text-slate-300">
                {item.degree}
                <span class="text-slate-500"> · {item.school}</span>
              </span>
              <span class="font-mono text-xs text-slate-500">{item.period}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
