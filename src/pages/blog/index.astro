---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getPosts } from "../../lib/rss";

const posts = await getPosts();
---

<BaseLayout
  title="Blog"
  description="Notes on software development, system design, cloud architecture, and real-world project experience."
>
  <section class="flex flex-col gap-8">
    <div>
      <p class="font-mono text-sm text-accent">/blog</p>
      <h1 class="mt-2 font-mono text-3xl font-bold text-white sm:text-4xl">
        writing
      </h1>
      <p class="mt-3 text-sm text-slate-400">
        Notes on software development, system design, cloud architecture, and
        real-world project experience. Posts are published on Substack.
      </p>
    </div>

    {posts.length === 0 && (
      <div class="rounded-lg border border-slate-800 p-8 text-center">
        <p class="font-mono text-sm text-slate-500">
          No posts yet. Configure PUBLIC_SUBSTACK_URL in your environment.
        </p>
      </div>
    )}

    <div class="flex flex-col gap-4">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>
</BaseLayout>
