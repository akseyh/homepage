---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404"
  description="Page not found."
>
  <section class="flex flex-col items-start gap-4">
    <p class="font-mono text-sm text-accent">/404</p>
    <h1 class="font-mono text-3xl font-bold text-white sm:text-4xl">
      page not found
    </h1>
    <p class="text-sm text-slate-400">
      This page doesn&rsquo;t exist or has moved. The good stuff is one click
      away.
    </p>
    <a
      href="/"
      class="rounded border border-slate-700 px-4 py-2 font-mono text-sm text-slate-300 transition-colors hover:border-accent hover:text-accent"
    >
      back home &rarr;
    </a>
  </section>
</BaseLayout>
