---
import BaseLayout from "../layouts/BaseLayout.astro";

const currently = [
  "Writing notes about backend engineering and AI tooling.",
  "Open to backend and platform roles.",
];
---

<BaseLayout
  title="Home"
  description="Şems Yılmaz — full-stack engineer focused on backend systems, distributed data, cloud infrastructure, and AI tooling."
>
  <section class="flex flex-col gap-10">
    <div>
      <p class="font-mono text-sm text-accent">hey, i&rsquo;m</p>
      <h1 class="mt-2 font-mono text-4xl font-bold text-white sm:text-5xl">
        şems yılmaz
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">
        Full-stack engineer with six years of experience, mostly on the
        backend. I like systems where correctness matters &mdash; and I care
        about the whole path from the database to the UI.
      </p>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-400">
        I work with Node.js, NestJS, TypeScript, Kafka, PostgreSQL, and
        Kubernetes: backend-first, with enough frontend to ship the whole
        feature. Lately that also includes LLM-powered workflows and internal
        tooling.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/blog"
          class="rounded bg-accent px-4 py-2 font-mono text-sm font-medium text-slate-950 transition-opacity hover:opacity-90"
        >
          read the writing &rarr;
        </a>
        <a
          href="https://github.com/akseyh"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-slate-700 px-4 py-2 font-mono text-sm text-slate-300 transition-colors hover:border-accent hover:text-accent"
        >
          github &rarr;
        </a>
      </div>
    </div>

    <div>
      <h2
        class="font-mono text-sm font-semibold uppercase tracking-wider text-slate-500"
      >
        currently
      </h2>
      <ul class="mt-4 space-y-3">
        {
          currently.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
              <span class="text-sm text-slate-400">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
